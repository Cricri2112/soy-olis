# Copiá este archivo como .env.local y completá los valores.
# .env.local no se sube a git. En Vercel se cargan como variables de entorno del proyecto.

# URL del proyecto de Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave pública del proyecto (Project Settings > API Keys > publishable).
# Es pública por diseño: el acceso real lo controlan las políticas RLS.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# WhatsApp de la tienda: código de país + número, sin "+", espacios ni guiones.
VITE_WHATSAPP_NUMBER=598XXXXXXXX
